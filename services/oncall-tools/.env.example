# Copy to .env for local development (never commit .env). See docs/SPEC.md section 2.1 for the
# full contract. Any variable below can be left unset or set to the literal string "unset" to
# disable that integration; the service logs one warning at startup and degrades gracefully.

# --- Core ---
PORT=8080
# Public URL this service is reachable at (no trailing slash). Used to build Slack "Join call"
# links and the call page URL.
PUBLIC_BASE_URL=http://localhost:8080
# Shared secret every /tools/* request must send as `X-Oncall-Token: <token>`.
TOOL_API_TOKEN=dev

# --- ElevenLabs (voice agent) ---
# unset = ElevenLabs disabled: /call/:id loads but "Answer call" fails with a friendly error.
ELEVENLABS_API_KEY=unset
ELEVENLABS_AGENT_ID=unset
# HMAC secret for verifying POST /webhooks/elevenlabs/post-call.
ELEVENLABS_WEBHOOK_SECRET=unset

# --- Slack ---
# unset = Slack disabled: /oncall drill still works, alerts/call cards are only logged.
SLACK_BOT_TOKEN=unset
SLACK_SIGNING_SECRET=unset
SLACK_CHANNEL_ID=unset

# --- GitHub (GitOps repo) ---
# unset = GitHub disabled: propose_action/execute_action and the drill cannot commit changes.
GITHUB_TOKEN=unset
GITHUB_REPO=carnufex/Rosenvalls-Homelab
GITHUB_BRANCH=master
GITOPS_FILE=kubernetes/applications/oncall-demo/demo-api-deployment.yaml

# --- Kubernetes ---
# In-cluster config is used automatically when KUBERNETES_SERVICE_HOST is set; otherwise the
# client falls back to KUBECONFIG (or ~/.kube/config).
K8S_NAMESPACE=oncall-demo
ALLOWED_DEPLOYMENTS=demo-api
ARGOCD_APP_NAME=oncall-demo
ARGOCD_NAMESPACE=argocd

# --- Demo / drill ---
ONCALL_ENGINEER_NAME=Christopher
DEMO_IMAGE=registry.rosenvall.se/carnufex/oncall-demo-api
DEMO_GOOD_TAG=1.0.0
DEMO_BAD_TAG=1.1.0

# --- Detector / actions ---
DETECTOR_INTERVAL_MS=10000
ACTION_TTL_MS=120000

# --- Misc ---
LOG_LEVEL=info
# Set to 1 to enable POST /api/dev/incidents, which creates a fake incident without a cluster
# (used to exercise/screenshot the call page). Never set in production.
DEV_FIXTURES=0

# Slack user id used as created_by for Slack call cards when no /oncall drill user is known
SLACK_CALL_CREATED_BY=unset
# Timezone for spoken/local times
LOCAL_TIMEZONE=Europe/Stockholm
