{
  "name": "oncall-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "On-call Voice Copilot backend: agent tool endpoints, Slack integration, CrashLoop detector, and the ElevenLabs call page.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@kubernetes/client-node": "^1.0.0",
    "@octokit/rest": "^21.0.2",
    "@slack/web-api": "^7.8.0",
    "hono": "^4.6.13",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@elevenlabs/react": "^1.15.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
